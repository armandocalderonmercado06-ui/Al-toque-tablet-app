PORT=4173
HOST=0.0.0.0
DATA_BACKEND=file
DATA_DIR=data
APP_SERVER_URL=
TLS_CERT_FILE=
TLS_KEY_FILE=

# Set DATA_BACKEND=supabase and add these server-only credentials for hosted persistence.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# TURN is optional; TURN_URL accepts comma-separated ICE server URLs.
TURN_URL=
TURN_USER=
TURN_PASS=

# YouTube Data API v3 key used by the in-app video search.
YOUTUBE_API_KEY=

# Ollama handles ChatGPT/Gemini chat locally; provide a reachable server URL when hosting remotely.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=qwen3.5:2b
OLLAMA_API_KEY=

# Optional: current/complex questions use OpenAI web search when this key is configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Rider support falls back to this local service if Ollama is unavailable.
KERAS_API_URL=http://127.0.0.1:5000/preguntar

# Configure a strong private value to enable deleting Reels.
REELS_DELETE_PASSWORD=
